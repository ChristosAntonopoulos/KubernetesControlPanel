{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kubernetes": {
    "ApiServerUrl": "",
    "TokenPath": "/var/run/secrets/kubernetes.io/serviceaccount/token",
    "CertificatePath": "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt",
    "Namespace": "default",
    "CacheTimeout": "00:01:00"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/kubernetes-control-panel-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000"
    ]
  },
  "ExternalLinks": {
    "Categories": [
      {
        "Name": "Documentation",
        "Description": "Official guides and references",
        "Icon": "MenuBook",
        "Links": [
          {
            "Title": "Kubernetes Documentation",
            "Url": "https://kubernetes.io/docs/",
            "Description": "Official Kubernetes docs",
            "Icon": "Description",
            "Tags": ["k8s", "docs"]
          },
          {
            "Title": "Docker Hub",
            "Url": "https://hub.docker.com/",
            "Description": "Container images registry",
            "Icon": "Inventory",
            "Tags": ["docker", "registry"]
          }
        ]
      },
      {
        "Name": "Monitoring & Dashboards",
        "Description": "External observability tools",
        "Icon": "Insights",
        "Links": [
          {
            "Title": "Grafana",
            "Url": "https://grafana.com/",
            "Description": "Metrics and dashboards",
            "Icon": "BarChart",
            "Tags": ["monitoring"]
          },
          {
            "Title": "Prometheus",
            "Url": "https://prometheus.io/",
            "Description": "Time-series monitoring",
            "Icon": "Timeline",
            "Tags": ["monitoring", "metrics"]
          }
        ]
      },
      {
        "Name": "Team & Operations",
        "Description": "Tools outside the cluster",
        "Icon": "Groups",
        "Links": [
          {
            "Title": "Azure DevOps",
            "Url": "https://dev.azure.com/",
            "Description": "CI/CD and project tracking",
            "Icon": "Build",
            "Tags": ["ci", "devops"]
          },
          {
            "Title": "GitHub",
            "Url": "https://github.com/",
            "Description": "Source control",
            "Icon": "Code",
            "Tags": ["git", "source"]
          }
        ]
      }
    ]
  }
} 